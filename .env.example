# [必須] Discord Developer Portal で取得したボットのトークン
DISCORD_BOT_TOKEN=

# [必須] エージェントに作業させるワークスペースのディレクトリパス
BOT_WORKSPACE=

# 頭脳モード: claude (Claude Agent SDK) | webhook (外部エージェント連携)
# 省略時は claude
BOT_BRAIN=claude

# BOT_BRAIN=webhook のときに起床通知を送る webhook URL
BOT_WEBHOOK_URL=

# 使用する Claude モデル名（省略時は SDK の既定モデル）
BOT_MODEL=

# ツール実行時の権限モード: default | acceptEdits | bypassPermissions | plan | dontAsk | auto
# 省略時は bypassPermissions（Discord 発言を契機に任意のコマンドが実行されうるため注意）
BOT_PERMISSION_MODE=bypassPermissions

# セッション ID や受信添付ファイルを保存するディレクトリ（省略時はリポジトリ直下の .state）
BOT_STATE_DIR=.state

# アクセス制御設定ファイルのパス（省略時はリポジトリ直下の config.json）
BOT_CONFIG=config.json

# 1 を指定すると初回起動時に保存済みセッションを再開せず新規セッションを開始する
BOT_FRESH_SESSION=0

# webhook / acp モード用の定期巡回間隔（分）。0 または未設定で無効、有効にする場合は 1 以上を指定
BOT_PATROL_MINUTES=0

# 頭脳モード: claude（既定） | webhook | acp
BOT_BRAIN=claude

# BOT_BRAIN=webhook のとき必須: 通知先 webhook URL
BOT_WEBHOOK_URL=

# BOT_BRAIN=acp のとき必須: ACP エージェント起動コマンド
# 例: agy acp / opencode acp / gemini --experimental-acp / npx -y @agentclientprotocol/claude-agent-acp
BOT_ACP_COMMAND=

# BOT_BRAIN=acp の作業ディレクトリ（省略時は BOT_WORKSPACE）
BOT_ACP_CWD=

# BOT_BRAIN=acp で指定するモデル ID（availableModels に含まれる場合のみ適用）
BOT_ACP_MODEL=

# BOT_BRAIN=acp の指示書パス（省略時はリポジトリ直下の GEMINI_BRAIN.md）
BOT_ACP_INSTRUCTIONS=

# BOT_BRAIN=acp の 1 ターンタイムアウト秒数（省略時は 300）
BOT_ACP_PROMPT_TIMEOUT_SEC=300

# BOT_BRAIN=acp でセッションを作り直すまでのターン数上限（省略時は 200）
BOT_ACP_MAX_TURNS=200

# webhook / acp モード用の日誌定時時刻（HH:MM、JST）。未設定時は 23:55、空文字で無効
BOT_JOURNAL_TIME=23:55

# BOT_BRAIN=acp 時に Ctrl+C / SIGTERM で終了前日誌を書くか（1=有効 [既定]、0=無効）
BOT_JOURNAL_ON_EXIT=1

# BOT_BRAIN=acp の終了前日誌を待つ最大秒数（省略時は 120）
BOT_JOURNAL_EXIT_TIMEOUT_SEC=120
