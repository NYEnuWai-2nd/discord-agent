# [必須] Discord Developer Portal で取得したボットのトークン
DISCORD_BOT_TOKEN=

# [必須] エージェントに作業させるワークスペースのディレクトリパス
BOT_WORKSPACE=

# 頭脳モード: claude (Claude Agent SDK) | webhook (外部エージェント連携)
# 省略時は claude
BOT_BRAIN=claude

# BOT_BRAIN=webhook のときに起床通知を送る webhook URL
BOT_WEBHOOK_URL=

# 使用する Claude モデル名（省略時は SDK の既定モデル）
BOT_MODEL=

# ツール実行時の権限モード: default | acceptEdits | bypassPermissions | plan | dontAsk | auto
# 省略時は bypassPermissions（Discord 発言を契機に任意のコマンドが実行されうるため注意）
BOT_PERMISSION_MODE=bypassPermissions

# セッション ID や受信添付ファイルを保存するディレクトリ（省略時はリポジトリ直下の .state）
BOT_STATE_DIR=.state

# アクセス制御設定ファイルのパス（省略時はリポジトリ直下の config.json）
BOT_CONFIG=config.json

# 1 を指定すると初回起動時に保存済みセッションを再開せず新規セッションを開始する
BOT_FRESH_SESSION=0

# webhook モード用の定期巡回間隔（分）。0 または未設定で無効、有効にする場合は 1 以上を指定
BOT_PATROL_MINUTES=0
